{
  "name": "tailwindcss-template-card",
  "version": "3.2.0",
  "description": "A Home Assistant custom card that renders Jinja2 templates with Tailwind CSS styling",
  "author": "chintito4ever",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chintito4ever/tailwindcss-template-card.git"
  },
  "bugs": {
    "url": "https://github.com/chintito4ever/tailwindcss-template-card/issues"
  },
  "homepage": "https://github.com/chintito4ever/tailwindcss-template-card#readme",
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "tailwindcss",
    "twind",
    "jinja2",
    "template",
    "hacs"
  ],
  "type": "module",
  "main": "dist/tailwindcss-template-card.js",
  "exports": {
    ".": "./dist/tailwindcss-template-card.js",
    "./badge": "./dist/tailwindcss-template-badge.js"
  },
  "files": [
    "dist",
    "hacs.json"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:card && npm run build:badge",
    "build:card": "vite build --config vite.config.card.ts",
    "build:badge": "vite build --config vite.config.badge.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@twind/core": "^1.1.3",
    "@twind/preset-autoprefix": "^1.0.7",
    "@twind/preset-tailwind": "^1.1.4",
    "custom-card-helpers": "^1.9.0",
    "dompurify": "^3.0.8",
    "home-assistant-js-websocket": "^9.1.0",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit": "^1.11.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.7.1",
    "vitest": "^1.2.1"
  },
  "overrides": {
    "@twind/preset-autoprefix": {
      "typescript": "$typescript"
    },
    "@twind/preset-tailwind": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
